{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "/tmp/claude-0/-home-user-OpenAI-webMCP-hackthon/e0a4571e-35ad-5336-8047-b8c6cb676c1f/scratchpad/.next-build/types/**/*.ts",
    "/tmp/claude-0/-home-user-OpenAI-webMCP-hackthon/e0a4571e-35ad-5336-8047-b8c6cb676c1f/scratchpad/.next-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "web"
  ]
}
