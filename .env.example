# Loopback-only Ollama settings. Do not put API keys or patient data here.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

# Optional production TFDA snapshot. Use one absolute .json path on shared,
# durable storage. The scheduled snapshot contains public registry records only,
# never patient data. Run `npm run sync:tfda-snapshot` at least once per day.
TFDA_SNAPSHOT_PATH=

# Optional first-party Chrome WebMCP Origin Trial token for the exact SITE_URL.
# The token is intentionally emitted as public <meta> markup, but stays out of
# client JavaScript and is never returned by health/evidence JSON.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Public discovery remains fail-closed. Enable both only after every public-release
# gate in docs/READINESS.md is approved. SITE_URL must be a non-loopback HTTPS origin.
SITE_URL=
SITE_INDEXING_ENABLED=false
