# Ollama transport. Local development: your own Ollama on a loopback address,
# signed in to Ollama cloud (`ollama signin`), no key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud
# Deployments without a local Ollama (Netlify, containers): set a server-only
# Ollama Cloud API key. The base URL then must be https://ollama.com (default
# when a key is present) and the wire model becomes gpt-oss:120b automatically.
# Never commit a real key; set it in the hosting provider's secret store only.
OLLAMA_API_KEY=
# Optional server ceiling for one extraction call (10000-120000 ms).
CLOUD_EXTRACTION_TIMEOUT_MS=

# Optional production TFDA snapshot. Use one absolute .json path on shared,
# durable storage. The scheduled snapshot contains public registry records only,
# never patient data. Run `npm run sync:tfda-snapshot` at least once per day.
TFDA_SNAPSHOT_PATH=
TRIAL_INDEX_BACKEND=sqlite
TRIAL_INDEX_SQLITE_PATH=
# Set TRIAL_INDEX_BACKEND=postgres in deployed multi-instance environments.
DATABASE_URL=
TRIAL_INDEX_SYNC_SCHEDULE="0 2 * * * Asia/Taipei"
# Optional override; defaults to the versioned repository snapshot under data/public.
NCI_TERMINOLOGY_PATH=
NCI_CTS_API_KEY=

# Optional first-party Chrome WebMCP Origin Trial token for the exact SITE_URL.
# The token is intentionally emitted as public <meta> markup, but stays out of
# client JavaScript and is never returned by health/evidence JSON.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Public discovery remains fail-closed. Enable both only after every public-release
# gate in docs/READINESS.md is approved. SITE_URL must be a non-loopback HTTPS origin.
SITE_URL=
SITE_INDEXING_ENABLED=false
